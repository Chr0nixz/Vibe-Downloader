# ENG-02: make line-ending handling explicit. Without this file the result
# depends on each contributor's core.autocrlf setting, which is what produced
# the recurring "LF will be replaced by CRLF" noise and the mojibake incidents
# in RELEASE.md and download/hls/engine.rs.
#
# Text is stored and checked out as LF on every platform, Windows included.
# Biome's formatter requires LF, so a CRLF checkout made `pnpm lint` report a
# format error on all 299 checked files even though the committed blobs were
# already LF: a red check that said nothing about the code. An existing CRLF
# working tree is converted by `git rm --cached -r . && git reset --hard`,
# which rewrites no content because the index was already LF.

* text=auto eol=lf

# Shell scripts must keep LF even when checked out on Windows, otherwise
# git-bash, WSL and the Linux CI runners fail with "bad interpreter".
*.sh text eol=lf

# Source and config: store LF, check out LF.
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

# Binary assets: never convert line endings, never attempt a text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.torrent binary

# Generated lockfile: still tracked, but excluded from diffs to keep reviews
# readable. Cargo.lock is deliberately NOT listed - dependency changes there
# must stay reviewable.
pnpm-lock.yaml -diff
