{
  "name": "vibe-downloader",
  "private": true,
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "author": "Chr0nixz",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm check:i18n",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-completeness.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "specta": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "test:frontend": "vitest run",
    "test": "pnpm test:frontend && pnpm test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:bindings": "pnpm specta && git diff --exit-code src/generated/bindings.ts",
    "prepare:native-host": "node scripts/native-host-build.mjs",
    "prepare:updater-rehearsal": "node scripts/write-updater-rehearsal-config.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-tools": "node --test scripts/*.test.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "verify:protocol-matrix": "node scripts/verify-protocol-matrix.mjs",
    "build:extensions": "node scripts/build-browser-extensions.mjs",
    "verify:manifest": "node scripts/verify-extension-manifest.mjs",
    "verify:extensions": "pnpm build:extensions && pnpm verify:manifest",
    "sync-version": "node scripts/sync-version.mjs",
    "tauri": "tauri",
    "dev:tauri": "cross-env RUST_LOG=vibe_downloader=debug,tauri=warn,sqlx=debug tauri dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "fflate": "^0.8.2",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "biome check --fix --no-errors-on-unmatched"
  }
}
