{
  "name": "vibe-downloader",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "author": "Chr0nixz",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "specta": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:bindings": "pnpm specta && git diff --exit-code src/generated/bindings.ts",
    "build:extensions": "node scripts/build-browser-extensions.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "tauri": "tauri",
    "dev:tauri": "cross-env RUST_LOG=vibe_downloader=debug,tauri=warn,sqlx=debug tauri dev"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
